; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited using the UI and not by hand.

config_version=5

[application]

config/name="Jeoseung Dungeon"
config/description="한국 설화 기반 턴제 로그라이크 던전 크롤러"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

Constants="*res://scripts/core/Constants.gd"
MessageBus="*res://autoloads/MessageBus.gd"
SettingsManager="*res://autoloads/SettingsManager.gd"
AudioManager="*res://autoloads/AudioManager.gd"
GameState="*res://autoloads/GameState.gd"
SaveManager="*res://autoloads/SaveManager.gd"
IAPManager="*res://autoloads/IAPManager.gd"
ItemDatabase="*res://autoloads/ItemDatabase.gd"
MonsterDatabase="*res://autoloads/MonsterDatabase.gd"
DungeonState="*res://autoloads/DungeonState.gd"
TurnManager="*res://autoloads/TurnManager.gd"

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR.ttf"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation="portrait"
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.05, 1)

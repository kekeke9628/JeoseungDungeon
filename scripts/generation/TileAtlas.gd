## The atlas region of a tile, in atlas pixels.
static func region(tile_name: String) -> Rect2:
	var i: int = INDEX.get(tile_name, 0)
	return Rect2((i % COLS) * CELL, (i / COLS) * CELL, CELL, CELL)
